# Copia questo file in .streamlit/secrets.toml e compilalo.
# .streamlit/secrets.toml e' in .gitignore: NON deve finire su GitHub.
# Su Streamlit Cloud gli stessi valori si incollano in Settings -> Secrets.

NOME_LEGA = "Lega dei Fenomeni"

# Progetto Supabase -> Settings -> API
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"

# Usa la chiave "anon" per il sito pubblico in sola lettura.
# La "service_role" bypassa la RLS: mettila solo dove serve scrivere.
SUPABASE_KEY = "eyJhbGciOi..."
