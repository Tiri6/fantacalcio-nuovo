# MODELLO — non mettere qui le chiavi vere.
#
# Questo file e' versionato su Git: tutto cio' che ci scrivi finisce su GitHub.
# Le credenziali vere vanno in `.streamlit/secrets.toml` (senza `.example`),
# che e' in .gitignore e non viene mai committato:
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#     # poi compila secrets.toml, non questo file
#
# Su Streamlit Cloud non serve nessun file: i valori si incollano in
# Settings -> Secrets.

NOME_LEGA = "FantaCalcio NuoVo"

# Supabase -> Project Settings -> API
SUPABASE_URL = "https://IL-TUO-PROGETTO.supabase.co"

# ATTENZIONE: serve la chiave "service_role", non la "anon".
#
# L'app non legge soltanto: crea utenti, importa rose, ratifica scambi. Con la
# chiave anon la Row Level Security blocca tutte le scritture e la tabella
# utenti non e' nemmeno leggibile, quindi non si riesce nemmeno a fare login.
#
# La service_role bypassa la RLS. E' accettabile qui perche' Streamlit gira sul
# server: la chiave resta nel backend e non raggiunge mai il browser di chi usa
# il sito. A proteggere le scritture ci pensa il sistema di permessi dell'app
# (fantacalcio/autenticazione.py).
#
# Chi ha questa chiave puo' leggere, modificare e cancellare tutto il database.
#
# Se ti scappa in un file versionato, toglierla da Git NON BASTA: resta nella
# cronologia. E le chiavi legacy (anon / service_role) non si possono piu'
# rigenerare. Le vie d'uscita sono due:
#   1. Settings -> API Keys: crea una chiave "secret" nuova (sb_secret_...),
#      mettila qui, poi DISATTIVA le chiavi legacy dalla stessa pagina.
#   2. Se il database e' ancora vuoto: elimina il progetto Supabase e ricrealo.
#      Sparisce tutto, chiave compresa.
SUPABASE_KEY = "INCOLLA-QUI-LA-SERVICE-ROLE-SOLO-IN-secrets.toml"
